     RowBox[{"Assumptions", "->", 
      RowBox[{"h", ">", "0"}]}]}], "]"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol11", ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"h", "^", "2"}], "*", 
