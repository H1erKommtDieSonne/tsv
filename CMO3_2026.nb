         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "1"}], "/", "4"}], "+", 
            RowBox[{"k", "/", "x"}]}], ")"}], "*", 
          RowBox[{"y", "[", "x", "]"}]}]}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "1", "]"}], "==", 
        RowBox[{"yas", "[", 
         RowBox[{"1", ",", "k", ",", "h"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"y", "'"}], "[", "1", "]"}], "==", 
