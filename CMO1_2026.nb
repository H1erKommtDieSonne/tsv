Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "n", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", ":=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", ":=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"e", ":=", 
    RowBox[{"h", "*", 
     RowBox[{"(", " ", 
      RowBox[{"n", "+", 
       RowBox[{"1", "/", "2"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{"e", ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "2"}], "}"}]}], "]"}], 
    "\[IndentingNewLine]", 
    RowBox[{"D", "[", 
     RowBox[{"e", ",", "n"}], "]"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"S1", "[", "x_", "]"}], ":=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "*", "e"}], "-", 
        RowBox[{"y", "^", "2"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", "*", "e"}], "]"}]}], ",", "x"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{
        RowBox[{"x", ">", 
         RowBox[{"-", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"2", "*", "e"}], "]"}]}]}], "&&", 
        RowBox[{"x", "<", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", "*", "e"}], "]"}]}]}]}]}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S1", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", "4"], " ", 
    RowBox[{"(", 
     RowBox[{"\[Pi]", "+", 
      RowBox[{"2", " ", "n", " ", "\[Pi]"}], "+", 
      RowBox[{"2", " ", "x", " ", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "n"}], "-", 
         SuperscriptBox["x", "2"]}]]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"4", " ", "n"}]}], ")"}], " ", 
       RowBox[{"ArcTan", "[", 
        FractionBox["x", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "n"}], "-", 
           SuperscriptBox["x", "2"]}]]], "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"S2", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"-", 
    RowBox[{"S1", "[", 
     RowBox[{"x", ",", "n"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", "x_", "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"2", "*", "e"}], "-", 
     RowBox[{"x", "^", "2"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x1", ":=", 
   RowBox[{"-", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "*", "e"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x2", ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", "*", "e"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", 
           RowBox[{
            RowBox[{"S1", "[", "x", "]"}], "/", "h"}]}], "]"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"J", "[", "x", "]"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], "*", 
           RowBox[{"Pi", "/", "2"}]}], "]"}], "*", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", "*", 
            RowBox[{
             RowBox[{"S1", "[", "x", "]"}], "/", "h"}]}], "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"J", "[", "x", "]"}], "]"}], "]"}]}]}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", 
           RowBox[{
            RowBox[{"S1", "[", "x", "]"}], "/", "h"}]}], "]"}], "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"J", "[", "x", "]"}], "]"}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", "*", 
           RowBox[{"Pi", "/", "2"}]}], "]"}], "*", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"I", "*", 
            RowBox[{
             RowBox[{"S1", "[", "x", "]"}], "/", "h"}]}], "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"J", "[", "x", "]"}], "]"}], "]"}]}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "x1", ",", "x2"}], "}"}]}], "]"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"h", "^", "2"}]}], "/", "2"}], "*", 
      RowBox[{
       RowBox[{"u", "''"}], "[", "x", "]"}]}], "+", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], "/", "2"}], "*", 
      RowBox[{"u", "[", "x", "]"}]}]}], "==", 
