Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"2", "*", "e"}], "-", 
     RowBox[{"y", "^", "2"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "*", "e"}], "]"}]}], ",", "x"}], "}"}], ",", 
   RowBox[{"Assumptions", "->", 
    RowBox[{
     RowBox[{"x", ">", 
      RowBox[{"-", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "*", "e"}], "]"}]}]}], "&&", 
     RowBox[{"x", "<", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", "*", "e"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellChangeTimes->{{4.001135153570225*^9, 4.0011351780732555`*^9}, {
  4.0011352679509144`*^9, 4.0011352999340935`*^9}},
 CellLabel->
  "In[109]:=",ExpressionUUID->"71cd9a7e-9676-d84a-bcb7-25ee74a7cd4b"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "4"], " ", 
  RowBox[{"(", 
   RowBox[{"\[Pi]", "+", 
    RowBox[{"2", " ", "n", " ", "\[Pi]"}], "+", 
    RowBox[{"2", " ", "x", " ", 
     SqrtBox[
      RowBox[{"1", "+", 
       RowBox[{"2", " ", "n"}], "-", 
       SuperscriptBox["x", "2"]}]]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "+", 
       RowBox[{"4", " ", "n"}]}], ")"}], " ", 
     RowBox[{"ArcTan", "[", 
      FractionBox["x", 
       SqrtBox[
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "n"}], "-", 
         SuperscriptBox["x", "2"]}]]], "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.001135154993181*^9, 4.001135271615364*^9, 
  4.001135373982071*^9},
 CellLabel->
  "Out[109]=",ExpressionUUID->"4c8f3d06-31aa-2a49-b076-e70af53ac19a"]
}, Open  ]],

