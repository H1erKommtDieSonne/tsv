     RowBox[{"2", " ", 
      RowBox[{"ArcTan", "[", 
       FractionBox["x", 
        SqrtBox[
         RowBox[{"4", "-", 
          SuperscriptBox["x", "2"]}]]], "]"}]}]}], ")"}], "/.", 
   RowBox[{"x", "->", "1"}]}], "]"}]], "Input",
